# omnivoice.cpp TTS configuration
# Build instructions: git clone --recurse-submodules https://github.com/ServeurpersoCom/omnivoice.cpp omnivoice-tts
# Then: cd omnivoice-tts && cmake -B build -DGGML_METAL=ON && cmake --build build -j
# Download GGUFs from https://huggingface.co/Serveurperso/OmniVoice-GGUF into omnivoice-tts/models/

export OMNIVOICE_TTS_PATH="/full/path/to/omnivoice-tts/build/omnivoice-tts"
export OMNIVOICE_MODEL_PATH="/full/path/to/omnivoice-tts/models/omnivoice-base-Q8_0.gguf"
export OMNIVOICE_CODEC_PATH="/full/path/to/omnivoice-tts/models/omnivoice-tokenizer-F32.gguf"
export OMNIVOICE_LANGUAGE="English"

# Optional R4 paths. Defaults to external/R4 26-11-06/ inside this repository.
# export SSL_AAI_BUNDLE_PATH="/full/path/to/R4 26-11-06"
# export SSL_AAI_CHECKPOINT_PATH="/full/path/to/R4 26-11-06/weights/r4.pt"

# Optional persistent preset location (relative paths resolve against the repo).
# export SPEECH_GUIDER_PRESETS_FILE="/full/path/to/presets.json"

# Optional overrides for the packaged app, when launched from a shell.
# export SPEECH_GUIDER_DESKTOP_STATE_DIR="/absolute/path/to/desktop-state"
# export SPEECH_GUIDER_ASSET_DIR="/absolute/path/to/installed/assets"
# export SPEECH_GUIDER_FFMPEG_PATH="/absolute/path/to/ffmpeg"
