{
  "name": "speech-guider",
  "version": "1.0.0",
  "description": "Pronunciation & Prosody Evaluator",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test tests/e2e/real/",
    "test:e2e:mocked": "playwright test tests/e2e/mocked/",
    "test:e2e:offline": "playwright test tests/e2e/mocked/offlineAssets.spec.js",
    "test:e2e:headed": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:py": "pytest",
    "lint": "npm run lint:js && npm run lint:py",
    "lint:js": "eslint . --no-warn-ignored",
    "lint:py": "ruff check . && ruff format . --check",
    "typecheck": "mypy .",
    "format:py": "ruff format .",
    "assets:build": "node scripts/build_frontend_assets.cjs",
    "assets:check": "node scripts/build_frontend_assets.cjs --check",
    "check": "npm run assets:check && npm run lint && npm run typecheck && npm run test:run && npm run test:py",
    "tauri": "tauri",
    "dev": "./scripts/dev.sh",
    "desktop:build": "npm run assets:check && speech-guider/bin/python scripts/build_desktop_backend.py && speech-guider/bin/python scripts/smoke_desktop_backend.py && npm run desktop:bundle",
    "desktop:bundle": "tauri build --config src-tauri/tauri.release.conf.json",
    "desktop:installer": "npm run desktop:build && speech-guider/bin/python scripts/build_desktop_installer.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tauri-apps/cli": "^2.10.1",
    "@vitest/coverage-v8": "^4.1.1",
    "eslint": "^10.10.0",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "plotly.js-dist-min": "2.32.0",
    "tailwindcss": "3.4.19",
    "vitest": "^4.1.1"
  }
}
